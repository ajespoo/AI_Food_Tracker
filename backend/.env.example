# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# Database
DATABASE_URL=sqlite:///food_tracker.db

# JWT
JWT_SECRET_KEY=change-me-to-another-long-random-string

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Twilio (optional — leave blank to use email OTP only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Google OAuth (for Google Fit)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (for CORS + Stripe redirects)
CLIENT_URL=http://localhost:5173
